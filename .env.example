# IAM (Asistente para el Adulto Mayor) - Variables de Entorno
# Copiar a .env y completar los valores

# ── LLM principal (OpenRouter) ─────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_MODEL=xiaomi/mimo-v2.5
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=xiaomi/mimo-v2.5

# ── Gemini AI (fallback) ─────────────────────────────────────────────
GEMINI_API_KEY=tu_gemini_api_key_aqui

# ── Pinecone (Base de conocimiento RAG) ──────────────────────────────
PINECONE_API_KEY=tu_pinecone_api_key_aqui

# ── Supabase (Base de datos) ────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key_aqui

# ── APIs externas (opcional - para clima, indicadores, noticias) ────
# OpenWeatherMap para clima (suscripción gratuita)
OPENWEATHER_API_KEY=tu_openweather_api_key_aqui
# API de TRM/dólar (ej: exchangerate-api, mindicador, etc.)
INDICADORES_API_URL=https://www.datos.gov.co/resource/32sa-8pi3.json

# ── TTS (voz cálida, masculina, colombiana, Natural) ────────────────
# Por defecto: Gonzalo (es-CO-GonzaloNeural) - masculina, colombiana, Natural.
# Otras voces latinas masculinas disponibles: es-MX-JorgeNeural, es-PE-AlexNeural,
# es-AR-TomasNeural, es-CL-LorenzoNeural, es-VE-SebastianNeural.
# Voces femeninas alternativas: es-CO-SalomeNeural, es-MX-DaliaNeural.
TTS_VOICE=es-CO-GonzaloNeural
# Prosodia para que la voz suene cálida, amigable y natural (no robótica):
TTS_RATE=-5%        # Un poquito más lento, mejor para adultos mayores
TTS_PITCH=+0Hz      # Tono neutro, evita sonar agudo
TTS_VOLUME=+0%      # Volumen neutro

# ── Servidor ────────────────────────────────────────────────────────
PORT=5000
